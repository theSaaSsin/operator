# ── EMAIL SENDING (Resend) ──────────────────────
# Get free at: resend.com → API Keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=
FROM_EMAIL=you@yourdomain.com

# ── EMAIL FINDING (Hunter.io) ───────────────────
# Get free at: hunter.io → API
# Free tier: 25 searches/month — upgrade for £49/mo
HUNTER_API_KEY=

# ── SMS OUTREACH (Twilio) ───────────────────────
# Get free at: twilio.com → sign up → Console
# Free trial: $15.50 credit (~200 SMS messages)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+447...   # your Twilio UK number

# ── X/TWITTER LEAD SEARCH ──────────────────────
# Get free at: developer.twitter.com → Apps → Keys
# Free Basic tier: 100 reads/month (enough for daily scanning)
TWITTER_BEARER_TOKEN=

# ── LINKEDIN LEAD SEARCH (via SerpAPI) ─────────
# Get free at: serpapi.com → API Key
# Free tier: 100 searches/month
SERPAPI_KEY=

# ── SERVER ─────────────────────────────────────
PORT=4000
