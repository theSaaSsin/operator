{
  "agents": {
    "defaults": {
      "workspace": "C:\\Users\\joshu/.openclaw-autoclaw/workspace",
      "heartbeat": {
        "every": "2h"
      },
      "compaction": {
        "reserveTokensFloor": 40000
      },
      "model": {
        "primary": "zai/zai_glm-5-turbo"
      }
    }
  },
  "tools": {
    "fs": {
      "workspaceOnly": true
    },
    "web": {
      "search": {
        "enabled": false
      }
    }
  },
  "models": {
    "providers": {
      "zai": {
        "baseUrl": "https://autoglm-api.autoglm.ai/autoclaw-proxy/proxy/autoclaw",
        "apiKey": "autoclaw-internal-proxy",
        "api": "openai-completions",
        "models": [
          {
            "id": "zai_glm-5-turbo",
            "name": "GLM-5-Turbo",
            "headers": {
              "X-Request-Model": "zai_glm-5-turbo"
            }
          }
        ],
        "headers": {
          "x_trace_id": "autoclaw-desktop"
        }
      }
    }
  },
  "skills": {
    "allowBundled": [
      "__none__"
    ]
  }
}